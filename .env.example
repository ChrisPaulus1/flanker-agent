# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (storage) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key. Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (LLM triage) ---
GEMINI_API_KEY=
# Resolved by `npm run resolve-model` rather than hardcoded — free-tier model
# availability changes over time. Leave blank to auto-resolve at runtime.
GEMINI_MODEL=


# --- Cron auth ---
# Shared secret required as `Authorization: Bearer <secret>` on /api/cron/poll.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Dashboard ---
# Public base URL of the deployment.
APP_BASE_URL=http://localhost:3000

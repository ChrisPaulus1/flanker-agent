# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# --- Supabase (storage) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key. Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (LLM triage) ---
GEMINI_API_KEY=
# Resolved by `npm run resolve-model` rather than hardcoded — free-tier model
# availability changes over time. Leave blank to auto-resolve at runtime.
GEMINI_MODEL=

# --- Resend (email delivery) ---
RESEND_API_KEY=
# Without a verified domain, Resend only allows onboarding@resend.dev as sender
# and only delivers to the address the Resend account was created with.
ALERT_EMAIL_FROM=Flanker <onboarding@resend.dev>
ALERT_EMAIL_TO=

# --- Cron auth ---
# Shared secret required as `Authorization: Bearer <secret>` on /api/cron/poll.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Dashboard ---
# Public base URL of the deployment, used for links in alert emails.
APP_BASE_URL=http://localhost:3000
